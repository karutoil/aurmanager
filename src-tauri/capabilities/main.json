{
  "identifier": "main-capability",
  "description": "Main capability for AurManager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "pacman",
          "cmd": "pacman",
          "args": true,
          "sidecar": false
        },
        {
          "name": "yay",
          "cmd": "yay",
          "args": true,
          "sidecar": false
        },
        {
          "name": "paru",
          "cmd": "paru",
          "args": true,
          "sidecar": false
        },
        {
          "name": "pkexec",
          "cmd": "pkexec",
          "args": true,
          "sidecar": false
        },
        {
          "name": "checkupdates",
          "cmd": "checkupdates",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
